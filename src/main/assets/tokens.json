{
  "_about": "Lumen design tokens. The app reads this exact file at runtime (Ui.kt). Roles stay, values change. Neutral greys on purpose: the UI must not tint how you judge a photo. Check with: python3 ~/.claude/skills/replica-design/contrast.py src/main/assets/tokens.json",
  "color": {
    "bg": "#121212",
    "surface": "#1c1c1c",
    "border": "#2e2e2e",
    "track": "#8a8a8a",
    "text": "#ececec",
    "text-muted": "#a8a8a8",
    "accent": "#e3b45f",
    "on-accent": "#121212",
    "danger": "#f07a7a",
    "success": "#6fcf97"
  },
  "pairs": [
    ["text", "bg"],
    ["text", "surface"],
    ["text-muted", "bg"],
    ["text-muted", "surface"],
    ["on-accent", "accent"],
    ["accent", "surface"],
    ["danger", "surface"],
    ["success", "surface"],
    ["track", "surface", "ui"],
    ["accent", "surface", "ui"]
  ],
  "font": { "sans": "system default (Roboto), no bundled font" },
  "type": {
    "xs":   {"size": 12, "line": 16, "weight": 500},
    "sm":   {"size": 14, "line": 20, "weight": 500},
    "base": {"size": 16, "line": 24, "weight": 400},
    "lg":   {"size": 20, "line": 28, "weight": 600}
  },
  "space": [0, 4, 8, 12, 16, 24, 32],
  "radius": {"sm": 8, "md": 12, "pill": 999},
  "size": {"touch": 48, "topbar": 56},
  "motion": {"fast": 120}
}
